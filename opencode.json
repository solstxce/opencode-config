{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "lsp": true,
  "small_model": "opencode/deepseek-v4-flash-free",
  "permission": {
    "read": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny",
      ".env*": "deny",
      "**/.env*": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.jks": "deny",
      "**/*.jks": "deny",
      "*credentials*": "deny",
      "**/*credentials*": "deny"
    },
    "edit": {
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny",
      ".env*": "deny",
      "**/.env*": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.jks": "deny",
      "**/*.jks": "deny",
      "*credentials*": "deny",
      "**/*credentials*": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*.p12*": "deny",
      "*.jks*": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws/*": "deny",
      "*/.azure/*": "deny",
      "*/.kube/*": "deny",
      "*/.docker/*": "deny",
      "*/.config/gcloud/*": "deny",
      "rm *": "ask",
      "sudo rm *": "ask",
      "chmod -R *": "ask",
      "chmod 000 *": "ask",
      "chmod 0 *": "ask",
      "chown *": "ask",
      "sudo chown *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "halt*": "ask",
      "poweroff*": "ask",
      "init 0*": "ask",
      "init 6*": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "kill -9 *": "ask"
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "default_agent": "build",
  "experimental": {
    "disable_paste_summary": true
  },
  "tool_output": {
    "max_lines": 120,
    "max_bytes": 12000
  },
  "compaction": {
    "auto": true,
    "tail_turns": 12
  },
  "agent": {
    "general": {
      "description": "General-purpose subagent for research, multi-step tasks, and handoffs from primary agents",
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "subagent",
      "permission": {
        "task": "allow"
      },
      "prompt": "{file:./prompts/general-guideline.md}"
    },
    "build": {
      "description": "Primary coding agent for implementation work, execution delegation, and review handoff",
      "model": "opencode-go/glm-5.1",
      "mode": "primary",
      "permission": {
        "external_directory": {
          "/tmp": "allow",
          "/tmp/**": "allow"
        },
        "task": "allow"
      },
      "prompt": "{file:./prompts/coding-guideline.md}"
    },
    "plan": {
      "description": "Primary planning agent for structured analysis and implementation plans without broad edits",
      "model": "github-copilot/gpt-5.4",
      "variant": "high",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          ".agents/tasks/*": "allow"
        },
        "task": "allow"
      },
      "prompt": "{file:./prompts/plan-guideline.md}"
    },
    "explore": {
      "description": "Read-only subagent for fast codebase exploration, file search, and code questions",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/explore-guideline.md}"
    },
    "executor": {
      "description": "Runs bash commands, tests, builds, and validation when a primary agent delegates execution",
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "external_directory": {
          "/tmp": "allow",
          "/tmp/**": "allow"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/executor-guideline.md}"
    },
    "reviewer": {
      "description": "Reviews changed code for bugs and regressions when a primary agent requests feedback",
      "model": "opencode-go/deepseek-v4-pro",
      "variant": "max",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": {
          "*": "deny",
          ".agents/tasks/*": "allow"
        },
        "task": "deny"
      },
      "prompt": "Use code-review skill. Review only the changed scope and write findings to .agents/tasks/review.md."
    },
    "expert-reviewer": {
      "description": "Performs final in-depth diff reviews with a premium model for high-risk changes",
      "model": "openai/gpt-5.5",
      "variant": "high",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": {
          "*": "deny",
          ".agents/tasks/*": "allow"
        },
        "task": "deny"
      },
      "prompt": "Use code-review skill. Perform a final in-depth review of the full diff against the task and plan, and write findings to .agents/tasks/review.md."
    }
  }
}
