{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "lsp": true,
  "small_model": "opencode/mimo-v2.5-free",
  "permission": {
    "read": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny",
      ".env*": "deny",
      "**/.env*": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.jks": "deny",
      "**/*.jks": "deny",
      "*credentials*": "deny",
      "**/*credentials*": "deny"
    },
    "edit": {
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny",
      ".env*": "deny",
      "**/.env*": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      "*.key": "deny",
      "**/*.key": "deny",
      "*.p12": "deny",
      "**/*.p12": "deny",
      "*.jks": "deny",
      "**/*.jks": "deny",
      "*credentials*": "deny",
      "**/*credentials*": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*.p12*": "deny",
      "*.jks*": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws/*": "deny",
      "*/.azure/*": "deny",
      "*/.kube/*": "deny",
      "*/.docker/*": "deny",
      "*/.config/gcloud/*": "deny",
      "rm *": "ask",
      "sudo rm *": "ask",
      "chmod -R *": "ask",
      "chmod 000 *": "ask",
      "chmod 0 *": "ask",
      "chown *": "ask",
      "sudo chown *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "halt*": "ask",
      "poweroff*": "ask",
      "init 0*": "ask",
      "init 6*": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "kill -9 *": "ask"
    }
  },
  "model": "opencode/mimo-v2.5-free",
  "default_agent": "general",
  "plugin": [
    "@ramtinj95/opencode-tokenscope@latest",
    "opencode-token-tracker",
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/sirius", "/etc", "/opt"],
      "enabled": true
    },
    "lottiefiles-creator": {
      "type": "local",
      "command": ["npx", "-y", "@lottiefiles/creator-mcp@latest"],
      "enabled": true
    },
    "lottiefiles-search": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-lottiefiles"],
      "enabled": true
    },
    "figma-dev": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio", "--figma-api-key", "{env:FIGMA_DEV_API_KEY}"],
      "enabled": true
    },
    "21st": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "{env:TWENTYFIRST_API_KEY}"
      },
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "figma-console": {
      "type": "local",
      "command": ["sh", "-c", "FIGMA_ACCESS_TOKEN=${FIGMA_CONSOLE_TOKEN} npx -y figma-console-mcp@latest"]
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "tool_output": {
    "max_lines": 120,
    "max_bytes": 12000
  },
  "compaction": {
    "auto": true,
    "tail_turns": 12
  },
  "agent": {
    "general": {
      "description": "Cheap primary orchestrator for normal use, planning handoff, and final review handoff",
      "model": "opencode/mimo-v2.5-free",
      "mode": "primary",
      "permission": {
        "task": "allow"
      },
      "prompt": "{file:./prompts/general-guideline.md}"
    },
    "build": {
      "description": "Primary coding agent for implementation work that delegates execution and review",
      "model": "opencode-go/glm-5.2",
      "mode": "all",
      "permission": {
        "external_directory": {
          "/tmp": "allow",
          "/tmp/**": "allow"
        },
        "task": "allow"
      },
      "prompt": "{file:./prompts/coding-guideline.md}"
    },
    "plan": {
      "description": "Structured implementation planning with task analysis and breakdown",
      "model": "opencode-go/kimi-k3",
      "variant": "high",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": {
          "*": "deny",
          ".agents/tasks/*": "allow"
        },
        "task": "allow"
      },
      "prompt": "{file:./prompts/plan-guideline.md}"
    },
    "explore": {
      "description": "Fast read-only codebase exploration and file search",
      "model": "opencode-go/ox-alpha-free",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/explore-guideline.md}"
    },
    "executor": {
      "description": "Default execution subagent for bash commands, tests, builds, and validation",
      "model": "opencode-go/hy3",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "external_directory": {
          "/tmp": "allow",
          "/tmp/**": "allow"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/executor-guideline.md}"
    },
    "reviewer": {
      "description": "Automated review agent",
      "model": "opencode-go/deepseek-v4-pro",
      "variant": "max",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": {
          "*": "deny",
          ".agents/tasks/*": "allow"
        },
        "task": "deny"
      },
      "prompt": "Use code-review skill. Review only the changed scope and write findings to .agents/tasks/review.md."
    },
    "expert-reviewer": {
      "description": "Performs in-depth diff reviews with a premium model for high-risk changes",
      "model": "opencode-go/ox-alpha-free",
      "variant": "max",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "edit": {
          "*": "deny",
          ".agents/tasks/*": "allow"
        },
        "task": "deny"
      },
      "prompt": "Use code-review skill. Perform a final in-depth review of the full diff against the task and plan, and write findings to .agents/tasks/review.md."
    }
  }
}