#!/usr/bin/env bash
# oc-switch — Switch OpenCode config between tiers (main ↔ free-tier ↔ totally-free-tier)
#
# Usage: oc-switch [branch]
#
#   oc-switch              cycle to the next tier in order
#   oc-switch main         switch to Normal tier
#   oc-switch free         switch to Free tier
#   oc-switch totally-free switch to Totally Free tier
#   oc-switch status       show current tier without switching
#
# Supports: Linux, macOS, WSL

set -euo pipefail

# ── Tier map ─────────────────────────────────────────────────────────────────

declare -A TIERS
TIERS[main]="Normal"
TIERS[free-tier]="Free"
TIERS[totally-free-tier]="Totally Free"

CYCLE_ORDER=(main free-tier totally-free-tier)

# ── Locate the config directory ──────────────────────────────────────────────

find_config_dir() {
  if [ -n "${OPENCODE_CONFIG:-}" ]; then
    dir="$(dirname "$OPENCODE_CONFIG")"
    if [ -d "$dir/.git" ]; then
      echo "$dir"
      return 0
    fi
  fi

  if [ -d "$HOME/.config/opencode/.git" ]; then
    echo "$HOME/.config/opencode"
    return 0
  fi

  if [ -d "$HOME/.opencode/.git" ]; then
    echo "$HOME/.opencode"
    return 0
  fi

  if [ -d "/mnt/c/Users" ]; then
    for userdir in /mnt/c/Users/*; do
      if [ -d "$userdir/.opencode/.git" ]; then
        echo "$userdir/.opencode"
        return 0
      fi
    done
  fi

  echo ""
}

# ── Resolve alias to branch name ─────────────────────────────────────────────

resolve_branch() {
  case "$1" in
    main|normal)           echo "main" ;;
    free|free-tier)        echo "free-tier" ;;
    totally-free|totally-free-tier|tfree) echo "totally-free-tier" ;;
    *)                     echo "" ;;
  esac
}

# ── Main ─────────────────────────────────────────────────────────────────────

CONFIG_DIR="$(find_config_dir)"

if [ -z "$CONFIG_DIR" ]; then
  printf "❌  Could not find an opencode config directory with a git repo.\n\n"
  printf "    Looked in:\n"
  printf "      • \$OPENCODE_CONFIG -> %s\n" "$(dirname "${OPENCODE_CONFIG:-unset}")"
  printf "      • %s/.config/opencode/\n" "$HOME"
  printf "      • %s/.opencode/\n" "$HOME"
  printf "      • /mnt/c/Users/*/.opencode/  (WSL)\n\n"
  printf "    Make sure you cloned the repo first (see install.md).\n"
  exit 1
fi

cd "$CONFIG_DIR"

CURRENT="$(git rev-parse --abbrev-ref HEAD)"

# ── Handle explicit argument ─────────────────────────────────────────────────

if [ $# -ge 1 ]; then
  ARG="$1"

  if [ "$ARG" = "status" ]; then
    LABEL="${TIERS[$CURRENT]:-$CURRENT}"
    printf "📋  Current tier: \033[1m%s\033[0m  (\033[1m%s\033[0m branch)\n" "$LABEL" "$CURRENT"
    exit 0
  fi

  TARGET="$(resolve_branch "$ARG")"
  if [ -z "$TARGET" ]; then
    printf "❌  Unknown tier '%s'.\n" "$ARG"
    printf "    Valid: main, free, totally-free, status\n"
    exit 1
  fi

  if [ "$CURRENT" = "$TARGET" ]; then
    printf "📋  Already on \033[1m%s\033[0m (\033[1m%s tier\033[0m).\n" "$CURRENT" "${TIERS[$TARGET]}"
    exit 0
  fi

  printf "🔄  Switching from \033[1m%s\033[0m → \033[1m%s\033[0m ...\n" "$CURRENT" "$TARGET"
  git checkout "$TARGET"
  printf "\n✅  Now on \033[1m%s\033[0m — \033[1m%s tier\033[0m\n" "$TARGET" "${TIERS[$TARGET]}"
  printf "\n    Run \`opencode debug config\` to verify, then restart OpenCode.\n"
  exit 0
fi

# ── No argument — cycle to the next tier ────────────────────────────────────

# Find current position in cycle
IDX=-1
for i in "${!CYCLE_ORDER[@]}"; do
  if [ "${CYCLE_ORDER[$i]}" = "$CURRENT" ]; then
    IDX=$i
    break
  fi
done

if [ "$IDX" -eq -1 ]; then
  printf "❌  Unexpected branch '%s'.\n" "$CURRENT"
  printf "    Expected one of: %s\n" "${CYCLE_ORDER[*]}"
  exit 1
fi

NEXT_IDX=$(( (IDX + 1) % ${#CYCLE_ORDER[@]} ))
NEW="${CYCLE_ORDER[$NEXT_IDX]}"
LABEL="${TIERS[$NEW]}"

printf "🔄  Switching from \033[1m%s\033[0m → \033[1m%s\033[0m ...\n" "$CURRENT" "$NEW"
git checkout "$NEW"

printf "\n✅  Now on \033[1m%s\033[0m — \033[1m%s tier\033[0m\n" "$NEW" "$LABEL"
printf "\n    Run \`opencode debug config\` to verify, then restart OpenCode.\n"
